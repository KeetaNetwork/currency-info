{
	"compilerOptions": {
		"target": "ES2016",
		"removeComments": true,
		"rootDir": "./src",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"strict": true,
		"sourceMap": false,
		"skipLibCheck": true,
		"declaration": true,
		"outDir": "./dist"
	},
	"include": [
		"./src/**.ts"
	],
	"ignore": [
		"./src/generator/**"
	]
}
